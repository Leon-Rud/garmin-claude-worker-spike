{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-claude",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": false },
  // Caches the 24h Garmin access token so the key is not re-minted on every call (Garmin 429s after ~16 mints/hour).
  // No "id": wrangler deploy auto-creates the namespace in the buyer's account (automatic provisioning).
  "kv_namespaces": [{ "binding": "TOKENS" }]
}
